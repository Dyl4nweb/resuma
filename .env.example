# Database
# Production Postgres URL (e.g., Supabase, Neon, RDS)
DATABASE_URL="postgresql://user:password@localhost:5432/resuma"

# Next Auth Configuration
# Generate a secure secret for production using: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# Must match your production domain exactly (e.g. https://resuma.com)
NEXTAUTH_URL="http://localhost:3000"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Configuration
# Use Live keys in production! Test keys (sk_test_) will fail the production guard logic.
STRIPE_SECRET_KEY="sk_live_..."
# Webhook secret to verify Stripe events
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID for the PRO monthly tier
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."

# Resend Email Configuration
RESEND_API_KEY=
